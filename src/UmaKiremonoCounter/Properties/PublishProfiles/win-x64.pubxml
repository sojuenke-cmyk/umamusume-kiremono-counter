<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用ビルド（.NET ランタイム同梱の単一 exe）。
  dotnet publish src/UmaKiremonoCounter -p:PublishProfile=win-x64

  WPF の DirectWriteForwarder.dll などの C++/CLI 混在アセンブリは単一ファイル内から直接読み込めないため、
  IncludeAllContentForSelfExtract で起動時に一時フォルダへ展開してから実行する。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
